-- Employees whose name ends with 'a'
SELECT * FROM employees
WHERE name LIKE '%a';

-- Employees whose name contains 'an'
SELECT * FROM employees
WHERE name LIKE '%an%';

-- Employees whose name has exactly 5 characters
SELECT * FROM employees
WHERE LENGTH(name) = 5;

-- Employees whose name starts with S and salary is above 50000
SELECT * FROM employees
WHERE name LIKE 'S%'
  AND salary > 50000;


-- Top 5 highest-paid employees
SELECT name, salary
FROM employees
ORDER BY salary DESC
LIMIT 5;

-- Employees sorted by name alphabetically
SELECT name, department, salary
FROM employees
ORDER BY name;

########### Aggregation ####################
-- Number of employees in each department
SELECT department, COUNT(*) AS employee_count
FROM employees
GROUP BY department;

-- Departments with more than 10 employees
SELECT department, COUNT(*) AS employee_count
FROM employees
GROUP BY department
HAVING COUNT(*) > 10;

-- Average salary by department
SELECT department, AVG(salary) AS avg_salary
FROM employees
GROUP BY department;

####### JOIN ##########
-- Employee names with department names
SELECT e.name, d.department_name
FROM employees e
JOIN departments d
  ON e.department_id = d.department_id;

-- Departments that have no employees
SELECT d.department_name
FROM departments d
LEFT JOIN employees e
  ON d.department_id = e.department_id
WHERE e.emp_id IS NULL;


#### SALARY ##########
-- Second-highest distinct salary
SELECT MAX(salary) AS second_highest_salary
FROM employees
WHERE salary < (SELECT MAX(salary) FROM employees);

-- Highest-paid employee in each department
SELECT name, department, salary
FROM (
  SELECT *,
         DENSE_RANK() OVER (
           PARTITION BY department
           ORDER BY salary DESC
         ) AS rnk
  FROM employees
) x
WHERE rnk = 1;

######## DUPLICATE AND NULL ############
-- Find duplicate employee names
SELECT name, COUNT(*) AS occurrences
FROM employees
GROUP BY name
HAVING COUNT(*) > 1;

-- Employees with no manager assigned
SELECT *
FROM employees
WHERE manager_id IS NULL;


######### SELF JOIN ##########
-- Employees earning more than their manager
SELECT e.name AS employee, m.name AS manager
FROM employees e
JOIN employees m
  ON e.manager_id = m.emp_id
WHERE e.salary > m.salary;


Quick pattern cheat sheet
Requirement	SQL pattern
Starts with S	LIKE 'S%'
Starts with S or R	LIKE 'S%' OR LIKE 'R%'
Ends with “an”	LIKE '%an'
Contains “an”	LIKE '%an%'
Second character is “a”	LIKE '_a%'
Exactly 4 characters	LIKE '____'
Case-insensitive starts with S	UPPER(name) LIKE 'S%'


#########################################################3
WHERE: filters rows before aggregation.
GROUP BY: creates one output row per group.
HAVING: filters groups after aggregation.
ORDER BY: sorts the final result.


-- Employees earning above company average
SELECT name, salary
FROM employees
WHERE salary > (
  SELECT AVG(salary)
  FROM employees
);

-- Employees in departments located in Mumbai
SELECT name
FROM employees
WHERE department_id IN (
  SELECT department_id
  FROM departments
  WHERE location = 'Mumbai'
);

| Concept           | Meaning                                                         |
| ----------------- | --------------------------------------------------------------- |
| Primary key       | Uniquely identifies each row; cannot be NULL                    |
| Foreign key       | Links a column to a primary/unique key in another table         |
| Unique constraint | Prevents duplicate values, but may allow NULL depending on DBMS |
| NOT NULL          | Value must be provided                                          |
| DEFAULT           | Value used when none is supplied                                |
| CHECK             | Enforces a condition                                            |
| Index             | Speeds up lookups; can slow inserts/updates                     |


NULL handling
-- NULL is not equal to anything, including NULL
WHERE manager_id IS NULL
WHERE manager_id IS NOT NULL

-- Replace NULL in output
SELECT COALESCE(manager_id, 0) AS manager
FROM employees;

-- Department-wise employee count, including departments with zero employees
SELECT d.department_name,
       COUNT(e.emp_id) AS employee_count
FROM departments d
LEFT JOIN employees e
  ON d.department_id = e.department_id
GROUP BY d.department_name;



| Topic                       | Difference                                                                                     |
| --------------------------- | ---------------------------------------------------------------------------------------------- |
| DELETE vs TRUNCATE          | DELETE can filter rows and may be rolled back; TRUNCATE removes all rows and is usually faster |
| WHERE vs HAVING             | WHERE filters rows; HAVING filters groups                                                      |
| UNION vs UNION ALL          | UNION removes duplicates; UNION ALL keeps them                                                 |
| INNER JOIN vs LEFT JOIN     | Inner keeps matches only; left keeps all left-table rows                                       |
| RANK() vs DENSE_RANK()      | RANK() skips ranks after ties; DENSE_RANK() does not                                           |
| Primary key vs unique key   | Primary key identifies a row and is generally one per table; unique key prevents duplicates    |
| GROUP BY vs window function | GROUP BY collapses rows; window functions retain rows                                          |




